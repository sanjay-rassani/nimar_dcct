# Django
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Database (used by Docker Compose Postgres + Django)
POSTGRES_DB=nimar_dcct
POSTGRES_USER=nimar
POSTGRES_PASSWORD=nimar_dev_password
DATABASE_URL=postgres://nimar:nimar_dev_password@db:5432/nimar_dcct

# Seed on first boot (management command)
SEED_DEMO_DATA=1

# Optional default passwords for seeded users (change in real deployments)
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_MEMBER_PASSWORD=MemberPass123!
SEED_NIMAR_PASSWORD=NimarPass123!

# Evidence uploads (bytes)
EVIDENCE_MAX_UPLOAD_BYTES=10485760

# Production
# DJANGO_SETTINGS_MODULE=config.settings.prod
# SEED_DEMO_DATA=0
# BACKUP_RETENTION_DAYS=14
# ENABLE_HSTS=1
